<template>
  <div class="calculator">
    <h2>混凝土放热量与绝热温升计算器</h2>
    <div class="input-group">
      <label for="inputA">变量A:</label>
      <input id="inputA" v-model.number="a" type="number" placeholder="请输入数字">
    </div>
    <div class="input-group">
      <label for="inputB">变量B:</label>
      <input id="inputB" v-model.number="b" type="number" placeholder="请输入数字">
    </div>
    <div class="input-group">
      <label for="inputC">变量C:</label>
      <input id="inputC" v-model.number="c" type="number" placeholder="请输入数字">
    </div>
    <button @click="calculateSum">计算总和</button>
    <div class="result" v-if="showResult">
      总和 S = {{ sum }}
    </div>
  </div>
</template>

<script setup>
import { ref } from 'vue';

const a = ref(0);
const b = ref(0);
const c = ref(0);
const sum = ref(0);
const showResult = ref(false);

const calculateSum = () => {
  sum.value = a.value + b.value + c.value;
  showResult.value = true;
};
</script>

